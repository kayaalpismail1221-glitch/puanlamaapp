# Supabase bağlantısı. Bu dosyayı `.env.local` adıyla kopyalayıp değerleri doldurun.
# Değerler: Supabase paneli → Project Settings → API (Project URL ve anon/publishable key)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Android (isteğe bağlı; yoksa ilgili özellik gizlenir). Kurulum: SUPABASE.md → "Android: Google ile giriş ve push"
# Google Cloud → APIs & Services → Credentials → "Web application" OAuth istemcisinin kimliği
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Firebase google-services.json yolu (Android push). EAS'ta "file" türü değişken
GOOGLE_SERVICES_JSON=
